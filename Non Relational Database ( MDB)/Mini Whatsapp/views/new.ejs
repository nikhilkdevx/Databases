<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <h3>Add your Chat</h3>
    <form method="post" action="/chats">
        <div class="chat">
            <input type="text" class="name" name="from" placeholder="Who are you ? ">
            <br><br>
            <textarea class="msg" name="msg" type="text" placeholder="Type your Message" style="height: 50px; width: 200px;"></textarea>
             <br><br>
            <input type="text" name="to" placeholder="Sending Whome ?"> 
             <br><br>
            <button class="btn">Create Chat</button>
        </div>
    </form>
</body>
</html>