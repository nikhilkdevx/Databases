<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <style>
        table , tr , td{
            border: 1px solid black;
        }
    </style>
</head>
<body>
    <h2>We are At Users Window</h2>
    <form method = "get" ACTION ="/users/add">
        <button>Add Users</button>
    </form>
    <br>
    <br>
    <table>
        <tr>
            <th>id</th>
            <th>Email</th>
            <th>username</th>
        </tr>
        <%for(user of users){%>
        <tr>
            <td><%= user.id %></td>
            <td><%= user.email %></td>
            <td><%= user.username %></td>
            <td>
                <form method = "get" ACTION ="/users/<%=user.id%>/edit">
                    <button>Edit Username</button>
                </form>
            </td>
            
            <td>
                <form method = "get" action ="/users/<%= user.id %>?_method=DELETE">
                    <button>Delete User</button>
                </form>
            </td>
            
        </tr>
<% } %>
    </table>
</body>
</html>

